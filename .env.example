# ==============================================================================
# Database Configuration for Vercel Deployment (choose EITHER Option A or B)
# ==============================================================================

# Option A (Recommended): PostgreSQL — works with Neon, Supabase, or Vercel Postgres
# When you attach Neon Postgres in Vercel Marketplace, POSTGRES_URL / DATABASE_URL is added automatically.
POSTGRES_URL="postgres://user:password@ep-your-db.neon.tech/neondb?sslmode=require"

# Option B: Upstash Redis / Vercel KV (REST API)
# When you attach Upstash Redis in Vercel Marketplace, these are added automatically.
# KV_REST_API_URL="https://your-instance.upstash.io"
# KV_REST_API_TOKEN="your-upstash-token"
